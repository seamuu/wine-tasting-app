// Data model for card-v2: one card per wine per taster.
//
// Two things stay deliberately blind on paper and are only resolved here.
// A taster writes no name - they mark two bubbles from a vocabulary the host
// chose (Skinny/Twink, Colours/Animals, ...) - and a wine is only ever "A".
// Because the vocabulary is switchable per event, the taster's two picks are
// stored as plain strings rather than enums: the card is the source of truth
// for what words exist, and the scanner reads them out of the card's own DOM.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FlightPosition {
  A
  B
  C
  D
  E
  F
  G
  H
}

enum WineSide {
  WHITE
  RED
}

// Retained for existing databases. The product now always uses BLIND;
// Wine.stage and the saved run cursor control the explicit reveal.
enum RevealMode {
  BLIND
  OPEN
}

enum WineStage {
  UPCOMING // not poured yet
  POURING  // cards being filled in
  LOCKED   // cards in, scoring done, reveal not yet shown
  REVEALED // shown on the big screen
}

enum ScanStatus {
  NEEDS_REVIEW // something was ambiguous or contradictory
  CONFIRMED
  MANUAL // typed in by the host because the card would not read
}

model Event {
  id         String     @id @default(cuid())
  name       String
  date       DateTime   @default(now())
  idSet      String     @default("house") // which taster vocabulary the cards were printed with
  revealMode RevealMode @default(BLIND)
  cardVersion String    @default("card-v2")
  createdAt  DateTime   @default(now())

  // Both are printed onto the card and so must be settled before the pack is
  // run off: wineCount decides how many letters appear in the Wine row, and
  // guestCount is what "everyone's card is in" is measured against.
  wineCount  Int        @default(4)
  guestCount Int?
  // Whether the price round is printed on the individual card or guessed by the
  // team on the matching sheet. It changes the card's layout, so the scanner
  // has to be told which one it is looking at.
  priceOnCard Boolean   @default(true)

  // The host and the room's display resume at the same point after a reload.
  activePosition FlightPosition @default(A)
  runStep        String         @default("COLLECT")
  mapMode        String         @default("OFF") // EUROPE / WORLD / OFF; frozen after collection

  wines       Wine[]
  tasters     Taster[]
  submissions Submission[]
  teams       Team[]
}

model Wine {
  id       String         @id @default(cuid())
  eventId  String
  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  position FlightPosition
  side     WineSide
  stage    WineStage      @default(UPCOMING)

  // --- identity, usually filled from a Vinmonopolet listing ---
  name       String
  producer   String?
  vintage    Int?
  region     String?
  appellation String?
  country    String?
  grapes     String? // "Corvina 40%, Corvinone 20%, ..." as printed on the listing
  sourceUrl  String?
  sourceRef  String? // Vinmonopolet product number
  // A representative point chosen by the host, independent of the printed grid.
  mapLatitude  Float?
  mapLongitude Float?
  teaser     String? // one non-identifying line to show during a blind round

  // --- measured facts, straight off the listing ---
  priceNok   Decimal? @db.Decimal(10, 2)
  alcohol    Decimal? @db.Decimal(4, 2)
  sugarGl    Decimal? @db.Decimal(5, 2)
  acidGl     Decimal? @db.Decimal(5, 2)
  tastingNote String?

  // --- the rest of what the listing's embedded JSON carries ---
  colour      String?
  smell       String?
  taste       String?
  storage     String?
  // Vinmonopolet's sensory ratings, each out of twelve. Kept raw as well as scaled
  // into the answer key, because "Fylde 12 of 12" is worth showing at a reveal.
  bodyRaw     Int?
  acidRaw     Int?
  tanninRaw   Int?
  sweetRaw    Int?
  foodPairing String[] @default([])
  // Their written explanation of each grape - teaching copy, free.
  grapeNotes  Json?

  // --- the host's answer key ---
  // priceBucket is an index into the card's printed buckets rather than a
  // price, because that is the granularity a taster can actually answer at.
  priceBucket   Int?
  keyBody       Int?
  keyAcidity    Int?
  keyTannin     Int?
  keySweetness  Int?
  keyAlcohol    Int?
  keyFlavours   String[] @default([]) // "Red fruit|Cherry"
  keyLockedAt   DateTime?

  submissions Submission[]
  guessesAbout TeamGuess[] @relation("GuessAbout")
  guessesChoice TeamGuess[] @relation("GuessChoice")
  mapGuesses TeamMapGuess[]

  @@unique([eventId, position])
}

/**
 * The matching round: a team, and what they matched to what.
 *
 * Separate from Taster on purpose. A taster is one palate and fills in their
 * own card; a team is five of them arguing over one sheet, and the two
 * leaderboards are answers to different questions.
 */
model Team {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name    String
  memberCount Int @default(1)
  guesses TeamGuess[]
  mapGuesses TeamMapGuess[]

  @@unique([eventId, name])
}

enum QuizCategory {
  PRICE
  ORIGIN
  NOTE
  GRAPE
}

model TeamGuess {
  id       String       @id @default(cuid())
  teamId   String
  team     Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  category QuizCategory
  // the glass being answered about...
  wineId   String
  wine     Wine         @relation("GuessAbout", fields: [wineId], references: [id], onDelete: Cascade)
  // ...and the wine whose answer they picked. Right when the two are the same.
  choiceId String
  choice   Wine         @relation("GuessChoice", fields: [choiceId], references: [id], onDelete: Cascade)

  @@unique([teamId, wineId, category])
}

model TeamMapGuess {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  wineId String
  wine   Wine   @relation(fields: [wineId], references: [id], onDelete: Cascade)
  cell   String

  @@unique([teamId, wineId])
}

// One person at one event. They never write their name on the card; the host
// can attach a real one here afterwards so the leaderboard reads properly.
model Taster {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  idA     String // first bubble group, e.g. "Hot"
  idB     String // second bubble group, e.g. "Mommy"
  name    String?

  submissions Submission[]

  @@unique([eventId, idA, idB])
}

// One scanned card: what one taster said about one wine.
model Submission {
  id       String @id @default(cuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  wineId   String
  wine     Wine   @relation(fields: [wineId], references: [id], onDelete: Cascade)
  tasterId String
  taster   Taster @relation(fields: [tasterId], references: [id], onDelete: Cascade)

  side        WineSide // which face of the card was scanned, from the printed side code
  priceBucket Int?
  body        Int?
  acidity     Int?
  tannin      Int?
  sweetness   Int?
  alcohol     Int?
  rating      Int? // 1-10
  flavours    String[] @default([]) // "Red fruit|Cherry"

  status     ScanStatus @default(CONFIRMED)
  reviewNote String?
  photoPath  String?
  // every bubble's fill value, kept so a disputed read can be re-examined
  // without the original photo
  readings   Json?

  createdAt DateTime @default(now())

  @@unique([wineId, tasterId])
}
